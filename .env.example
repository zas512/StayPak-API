# Server
PORT=3000
NODE_ENV=development

# CORS - comma-separated list of frontend URLs
FRONTEND_URL=http://localhost:8100,http://localhost:4200,http://localhost:3000

# Database - Local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/staypak

# JWT Secrets - Generate strong random strings for production
JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth - Get from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Payment Gateways - Configure for production
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_RETURN_URL=http://localhost:4200/booking/payment/callback
JAZZCASH_INTEGRITY_SALT=your-jazzcash-integrity-salt

EASYPAISA_MERCHANT_ID=your-easypaisa-merchant-id
EASYPAISA_PASSWORD=your-easypaisa-password
EASYPAISA_RETURN_URL=http://localhost:4200/booking/payment/callback

SAFEPAY_MERCHANT_ID=your-safepay-merchant-id
SAFEPAY_API_KEY=your-safepay-api-key
SAFEPAY_RETURN_URL=http://localhost:4200/booking/payment/callback

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=StayPak <noreply@staypak.pk>

# Redis (for caching - optional)
REDIS_URL=redis://localhost:6379